
#include <behaviors/mouse_keys.dtsi>
#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

&lt {
    tapping-term-ms = <240>;
    flavor = "balanced";
    quick-tap-ms = <175>;
};

&mt {
    tapping-term-ms = <200>;
    flavor = "tap-preferred";
    quick-tap-ms = <150>;
};

&caps_word { continue-list = <UNDERSCORE MINUS>; };

/ {
    // custom shift using mod-morph 

    combos {
        compatible = "zmk,combos";

        par_l {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <3 4>;
        };

        par_r {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <5 6>;
        };

        bkt_l {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <23 24>;
        };

        bkt_r {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <25 26>;
        };

        brc_l {
            bindings = <&kp LEFT_BRACE>;
            key-positions = <13 14>;
        };

        brc_r {
            bindings = <&kp RIGHT_BRACE>;
            key-positions = <15 16>;
        };

        esc {
            bindings = <&kp ESC>;
            key-positions = <0 1>;
        };

        del_l {
            bindings = <&kp DELETE>;
            key-positions = <20 21>;
        };

        del_r {
            bindings = <&kp DELETE>;
            key-positions = <29 28>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        qwrt_hrm {
            label = "QWRT_HRM";
            bindings = <
&kp Q      &kp W         &kp E     &kp R             &kp T                                  &kp Y            &kp U  &kp I      &kp O    &kp P
&kp A      &kp S         &kp D     &kp F             &kp G                                  &kp H            &kp J  &kp K      &kp L    &kp SEMI
&kp Z      &kp X         &kp C     &kp V             &kp B                                  &kp N            &kp M  &kp COMMA  &kp DOT  &kp SLASH
&kp LCTRL  &kp LEFT_WIN  &kp LALT  &mt LEFT_GUI TAB  &lt 1 SPACE  &lt 2 ENTER  &lt 3 ENTER  &lt 3 BACKSPACE                             &kp RSHFT
            >;
        };

        number_mouse {
            label = "NUM_MSE";
            bindings = <
&kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3     &kp NUMBER_4  &kp NUMBER_5                  &kp NUMBER_6  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp NUMBER_0
&kp NUMBER_6  &kp NUMBER_7  &kp NUMBER_8     &kp NUMBER_9  &kp NUMBER_0                  &kp PG_UP     &mkp LCLK     &mkp MCLK     &mkp RCLK     &mkp MB4
&kp KP_PLUS   &kp KP_MINUS  &kp KP_MULTIPLY  &kp KP_SLASH  &kp KP_DOT                    &kp PG_DN     &none         &none         &kp DOT       &mkp MB5
&trans        &trans        &trans           &trans        &trans        &trans  &trans  &trans                                                  &trans
            >;
        };

        symbol_scroll {
            label = "SYM_SCRL";
            bindings = <
&kp EXCLAMATION  &kp AT_SIGN  &kp HASH  &kp DOLLAR  &kp PERCENT                  &kp CARET      &kp AMPERSAND  &kp ASTERISK  &kp DEL    &kp BACKSPACE
&trans           &kp LEFT     &kp UP    &kp RIGHT   &kp PG_UP                    &kp BACKSLASH  &kp MINUS      &kp EQUAL     &kp GRAVE  &kp SQT
&trans           &kp END      &kp DOWN  &kp HOME    &kp PG_DN                    &kp PIPE       &kp UNDER      &kp PLUS      &kp TILDE  &kp DOUBLE_QUOTES
&trans           &trans       &trans    &trans      &trans       &trans  &trans  &trans                                                 &trans
            >;
        };

        function_layer {
            label = "FUN";
            bindings = <
&kp F1  &kp F2   &kp F3   &kp F4   &none                   &kp K_MUTE  &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC
&kp F5  &kp F6   &kp F7   &kp F8   &none                   &kp PG_UP   &kp LEFT           &kp UP           &kp RIGHT             &kp HOME
&kp F9  &kp F10  &kp F11  &kp F12  &none                   &kp PG_DN   &none              &kp DOWN         &none                 &kp END
&trans  &trans   &trans   &trans   &trans  &trans  &trans  &trans                                                                &trans
            >;
        };

        number {
            label = "NUM";
            bindings = <
&kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3     &kp NUMBER_4  &kp NUMBER_5                  &kp NUMBER_6  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp NUMBER_0
&kp NUMBER_6  &kp NUMBER_7  &kp NUMBER_8     &kp NUMBER_9  &kp NUMBER_0                  &kp PG_UP     &mkp LCLK     &mkp MCLK     &mkp RCLK     &mkp MB4
&kp KP_PLUS   &kp KP_MINUS  &kp KP_MULTIPLY  &kp KP_SLASH  &kp KP_DOT                    &kp PG_DN     &none         &none         &kp DOT       &mkp MB5
&trans        &trans        &trans           &trans        &trans        &trans  &trans  &trans                                                  &trans
            >;
        };

        snipe_layer {
            label = "SNIPE";
            bindings = <
&trans  &trans  &trans  &trans  &bootloader                  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                       &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                       &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans       &trans  &trans  &trans                          &trans
        };

        system {
            label = "SYS";
            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                  &none   &none  &none  &none  &none
&none         &none         &none         &none         &none                         &none   &none  &none  &none  &none
&bt BT_CLR    &none         &none         &none         &none                         &none   &none  &none  &none  &none
&none         &none         &none         &trans        &trans        &trans  &trans  &trans                       &bootloader
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        system {
            if-layers = <3 2>;
            then-layer = <4>;
        };
    };
};
